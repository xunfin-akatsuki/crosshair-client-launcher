<Window x:Class="CCL.App.Views.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Border x:Name="FallbackLayer" Background="{StaticResource FallbackBackgroundBrush}" CornerRadius="14" />

        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="14">
            <StackPanel Margin="26,22">
                <TextBlock Text="{DynamicResource Login.Title}" FontSize="15.5" FontWeight="Bold" />
                <TextBlock Text="{DynamicResource Login.Subtitle}"
                           Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap" />

                <!-- 未配置客户端 ID 时的引导 -->
                <StackPanel x:Name="ClientIdPanel" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Login.ClientIdLabel}" Style="{StaticResource CaptionText}" />
                    <TextBox x:Name="ClientIdBox" Style="{StaticResource InputBox}" Margin="0,7,0,0" />
                    <TextBlock Text="{DynamicResource Login.ClientIdHint}"
                               Style="{StaticResource CaptionText}" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 设备码 -->
                <Border x:Name="CodePanel" Background="#14FFFFFF" BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,16,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Login.EnterCode}" Style="{StaticResource CaptionText}" />
                        <TextBlock x:Name="UserCodeText" FontSize="26" FontWeight="Bold" Margin="0,8,0,0"
                                   FontFamily="Consolas, Microsoft YaHei UI" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="CopyCodeButton" Style="{StaticResource GhostButton}" Content="{DynamicResource Login.CopyCode}"
                                    Padding="14,7" FontSize="12" />
                            <Button x:Name="OpenBrowserButton" Style="{StaticResource GhostButton}"
                                    Content="{DynamicResource Login.OpenBrowser}" Padding="14,7" FontSize="12" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}" Margin="0,14,0,0"
                           Text="{DynamicResource Login.Ready}" />

                <!-- 未通过 Mojang 三方接入审核时显示 -->
                <Border x:Name="DetailPanel" Margin="0,14,0,0" Padding="14,12" CornerRadius="10"
                        Background="#1AF0A33C" BorderBrush="#59F0A33C" BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Login.WhyTitle}" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="{DynamicResource Login.WhyBody}" />
                        <Button x:Name="LearnMoreButton" Style="{StaticResource GhostButton}" Content="{DynamicResource Login.LearnMore}"
                                Padding="14,7" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CloseButton" Style="{StaticResource GhostButton}" Content="{DynamicResource App.Cancel}" />
                    <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Content="{DynamicResource Login.Start}"
                            Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
