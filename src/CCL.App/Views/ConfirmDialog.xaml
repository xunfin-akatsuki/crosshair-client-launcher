<Window x:Class="CCL.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- 材质不可用时用渐变兜底，避免窗口边缘露出纯黑 -->
        <Border x:Name="FallbackLayer" Background="{StaticResource FallbackBackgroundBrush}" CornerRadius="14" />

        <Border Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="14">
            <StackPanel Margin="26,22">
                <TextBlock x:Name="TitleText" FontSize="15.5" FontWeight="Bold" />
                <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" Margin="0,10,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="{DynamicResource App.Cancel}" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource DangerButton}" Content="确定"
                            Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
