<Window x:Class="CCL.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crosshair Client Launcher" Height="690" Width="1000"
        MinHeight="580" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Border x:Name="FallbackLayer" Background="{StaticResource FallbackBackgroundBrush}" />
        <Ellipse Width="820" Height="460" Fill="{StaticResource GlowBrush}"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-200,-220,0" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,6,0">
                    <Button x:Name="MinimizeButton" Style="{StaticResource ChromeButton}" ToolTip="{DynamicResource Tip.Minimize}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M1,7 H11" StrokeThickness="1.1" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" ToolTip="{DynamicResource Tip.Maximize}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="MaximizeGlyph" Data="M1.5,2 H10.5 V11 H1.5 Z" StrokeThickness="1.1"
                              StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseChromeButton}" ToolTip="{DynamicResource Tip.Close}"
                            Margin="4,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M2,2 L10,10 M10,2 L2,10" StrokeThickness="1.1" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 主体 -->
            <Grid Grid.Row="1" Margin="28,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="78" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 品牌区 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="2,0,22,0">
                    <Image Source="Assets/app-mark.png" Width="48" Height="48"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Crosshair Client" FontSize="17.5" FontWeight="Bold" />
                        <TextBlock Text="Launcher" FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource MutedInkBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 左栏：实例卡片 + 下载入口 -->
                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,22,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="8,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{DynamicResource App.Instances}" Style="{StaticResource CaptionText}"
                                       Margin="10,4,0,8" />

                            <ListBox Grid.Row="1" Style="{StaticResource RailListBox}"
                                     ItemsSource="{Binding Instances}"
                                     SelectedItem="{Binding SelectedInstance, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid AutomationProperties.Name="{Binding Id}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Id}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                                                           Text="{Binding SubtitleLabel}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- 只在鼠标停在实例行上时浮现；不绑定 IsHitTestVisible，
                                                 否则命中测试会在显示与隐藏之间反复抖动，提示气泡也无法稳定出现 -->
                                            <Border Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Opacity="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToOpacity}}">
                                                <Button Style="{StaticResource RowDeleteButton}"
                                                        ToolTip="{DynamicResource Tip.DeleteInstance}"
                                                        Command="{Binding DataContext.DeleteInstanceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <!-- 几何在 16×16 画布内左右上下对称，交给 ContentPresenter 居中 -->
                                                    <Path Data="M4,5 H12 M6.5,5 V3.5 H9.5 V5 M5.5,5 V12.5 H10.5 V5"
                                                          StrokeThickness="1.1" StrokeLineJoin="Round"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Button Grid.Row="1" Style="{StaticResource GhostButton}" Content="{DynamicResource App.NewVersion}"
                            Command="{Binding ShowDownloadCommand}" Margin="0,14,0,0" />
                </Grid>

                <!-- 右侧：两个视图叠放，切换时整体淡入上移 -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                    <Grid x:Name="InstanceView" Grid.Row="0"
                          Visibility="{Binding ShowInstance, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="InstanceOffset" />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="78" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource App.CurrentInstance}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding CurrentInstanceTitle}"
                                           FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CanLaunchHint}" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                <Button Style="{StaticResource GlassActionButton}" Content="{DynamicResource App.Launch}"
                                        Command="{Binding LaunchCommand}" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                            <StackPanel>
                                <Border Style="{StaticResource GlassCard}" Padding="22,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource App.VersionType}" Margin="0,0,22,11" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BodyText}"
                                                   Text="{Binding CurrentInstanceType}"
                                                   Margin="0,0,0,11" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource App.JavaRequired}" Margin="0,0,22,11" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyText}"
                                                   Text="{Binding CurrentInstanceJava}"
                                                   Margin="0,0,0,11" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource App.Client}" Margin="0,0,22,11" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyText}"
                                                   Text="{Binding CurrentInstanceSize}"
                                                   Margin="0,0,0,11" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource CaptionText}"
                                                   Text="{DynamicResource App.Directory}" Margin="0,0,22,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource BodyText}"
                                                   Text="{Binding CurrentInstanceDirectory}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource GlassCard}" Padding="22,18" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource App.LaunchSettings}" Style="{StaticResource CaptionText}"
                                                   Margin="0,0,0,14" />

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{DynamicResource App.Account}" Style="{StaticResource BodyText}"
                                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AccountLabel}" Style="{StaticResource BodyText}" />
                                                <TextBlock Text="{Binding AccountHint}" Style="{StaticResource CaptionText}"
                                                           Margin="12,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource App.SignInMs}"
                                                        Padding="14,7" FontSize="12"
                                                        Command="{Binding LoginMicrosoftCommand}" />
                                                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource App.UseOffline}"
                                                        Padding="14,7" FontSize="12" Margin="8,0,0,0"
                                                        Command="{Binding UseOfflineCommand}" />
                                                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource App.SignOut}"
                                                        Padding="14,7" FontSize="12" Margin="8,0,0,0"
                                                        Command="{Binding SignOutCommand}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{DynamicResource App.OfflineName}" Style="{StaticResource BodyText}"
                                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}"
                                                     Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Grid.Column="2" Text="{DynamicResource App.MaxMemory}" Style="{StaticResource BodyText}"
                                                       VerticalAlignment="Center" Margin="22,0,14,0" />
                                            <TextBox Grid.Column="3" Style="{StaticResource InputBox}"
                                                     Text="{Binding MemoryMb, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="180" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{DynamicResource App.Language}"
                                                       Style="{StaticResource BodyText}"
                                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                                            <ComboBox Grid.Column="1" Style="{StaticResource GlassComboBox}" ItemsSource="{Binding LanguageOptions}"
                                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                                      DisplayMemberPath="Display"
                                                      FontFamily="Microsoft YaHei UI" FontSize="12.5"
                                                      Padding="10,6" VerticalContentAlignment="Center" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource App.SaveSettings}"
                                                    Command="{Binding SaveSettingsCommand}" />
                                            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource App.OpenGameFolder}"
                                                    Command="{Binding OpenGameFolderCommand}" Margin="10,0,0,0" />
                                            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource App.ViewLogs}"
                                                    Command="{Binding OpenLogFolderCommand}" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="DownloadView" Grid.Row="0"
                          Visibility="{Binding ShowDownload, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="DownloadOffset" />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="78" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource App.InstallTitle}" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource App.InstallSubtitle}"
                                           Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource GlassCheckBox}" Content="{DynamicResource App.IncludeSnapshots}"
                                          IsChecked="{Binding ShowSnapshots}" VerticalAlignment="Center"
                                          Margin="0,0,16,0" />
                                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource App.BackToInstance}"
                                        Command="{Binding ShowInstanceCommand}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="6,8">
                                <ListBox Style="{StaticResource PlainListBox}" ItemsSource="{Binding Versions}"
                                         SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                         Padding="0,0,4,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid AutomationProperties.Name="{Binding Id}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Id}" FontSize="13.5" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0">
                                                        <Run Text="{Binding Type, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding ReleaseTime, StringFormat=yyyy-MM-dd, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                                        Content="{DynamicResource App.Install}" Padding="16,6" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <TextBlock Grid.Row="1" Style="{StaticResource CaptionText}" Margin="2,12,0,0"
                                       Text="{Binding GameFolderText}" />
                        </Grid>
                    </Grid>
                <!-- 任务队列 -->
                <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,12,0,0" Padding="18,13"
                        Visibility="{Binding HasTasks, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
    
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource App.TaskQueue}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TasksSummary}" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTasksExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
    
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Padding="13,6" FontSize="11.5" Command="{Binding ToggleTasksCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Content" Value="{DynamicResource App.Collapse}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTasksExpanded}" Value="False">
                                                    <Setter Property="Content" Value="{DynamicResource App.Expand}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource App.CancelAll}" Padding="13,6"
                                        FontSize="11.5" Margin="8,0,0,0" Command="{Binding CancelAllTasksCommand}" />
                                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource App.ClearFinished}" Padding="13,6"
                                        FontSize="11.5" Margin="8,0,0,0" Command="{Binding ClearFinishedTasksCommand}" />
                            </StackPanel>
                        </Grid>
    
                        <ScrollViewer Grid.Row="1" MaxHeight="136" VerticalScrollBarVisibility="Auto"
                                      Margin="0,9,0,0" Padding="0,0,4,0"
                                      Visibility="{Binding IsTasksExpanded, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
    
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource CaptionText}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
    
                                            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource GhostButton}"
                                                    Content="{DynamicResource App.Cancel}" Padding="12,4" FontSize="11.5"
                                                    Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
    
                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SlimProgress}"
                                                         Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                                         Margin="0,7,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
                </Grid>
            </Grid>


            <!-- 状态条 -->
            <Grid Grid.Row="3" Margin="28,0,28,0">
                <Border Height="1" VerticalAlignment="Top" Background="{StaticResource HairlineBrush}" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,9,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource MutedInkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding CurrentTask.Stage}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
